rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ► MHer73ZzKURFrmHRGW0CpX3McK63
    //   (Consola > Authentication > Users > coluna "User UID")
    function isProf() {
      return request.auth != null && request.auth.uid in ['MHer73ZzKURFrmHRGW0CpX3McK63'];
    }
    // Os alunos entram de forma anónima e invisível (não fazem login)
    function isAluno() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function camposAluno() {
      return ['uid','nome','nomeNorm','turma','prog','estrelas','estrelasMax','regras','nRegras',
              'tarefas','titulo','tituloHtml','regrasHtml','entregue','estado','validado','atualizado','versao'];
    }
    function dadosValidos(d) {
      return d.uid == request.auth.uid
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 60
        && d.turma is string && d.turma.size() <= 20
        && d.tituloHtml is string && d.tituloHtml.size() <= 3000
        && d.regrasHtml is string && d.regrasHtml.size() <= 20000
        && d.regras is list && d.regras.size() <= 30
        && d.validado == false
        && d.estado in ['em_curso', 'entregue']
        && d.atualizado == request.time;
    }

    // Configuração do exercício: todos leem, só o professor altera
    match /config/{docId} {
      allow read: if true;
      allow write: if isProf();
    }

    // Listas de alunos das turmas: só o professor
    match /turmas/{turmaId} {
      allow read, write: if isProf();
    }

    // Entregas dos alunos
    match /entregas/{entregaId} {
      // O professor vê tudo; cada computador só consegue ler as suas próprias entregas
      allow list: if isProf();
      allow get: if isProf() || (isAluno() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if isAluno()
        && request.resource.data.keys().hasOnly(camposAluno())
        && dadosValidos(request.resource.data);
      // O aluno pode melhorar o trabalho até o professor o validar
      allow update: if isProf() || (isAluno()
        && resource.data.uid == request.auth.uid
        && resource.data.validado == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposAluno())
        && dadosValidos(request.resource.data));
      allow delete: if isProf();
    }
  }
}
